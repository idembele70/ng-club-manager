{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "types": ["node", "@playwright/test"],
    "paths": {
      "@auth/*": ["auth/*"],
      "@config/*": ["config/*"],
      "@libs/domain/*": ["../libs/domain/*"],
      "@shared/*": ["shared/*"],
    },
    "composite": true
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../libs" },
  ]
}